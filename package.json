{
  "name": "edupass-jomthong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "CLOUDFLARE_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply edupass-dev --local",
    "db:migrate:prod": "wrangler d1 migrations apply edupass --remote --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:admin": "node scripts/setup-admin.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@opennextjs/cloudflare": "^1.20.10",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
